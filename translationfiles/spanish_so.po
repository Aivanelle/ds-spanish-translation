msgstr "Está cubierta de lapas."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.LIMPETROCK.PICKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.LIMPETROCK.PICKED"
