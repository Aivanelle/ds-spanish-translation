msgstr "No necesitamos tan sofisticada iluminación."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SWINGING_LIGHT_CHANDALIER_CANDLES
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SWINGING_LIGHT_CHANDALIER_CANDLES"
