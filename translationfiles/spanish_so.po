msgstr "Mmm. Me pregunto si arderá."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_LIMESTONE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_LIMESTONE"
