msgstr "Esa belleza también morirá."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LOTUS_FLOWER_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LOTUS_FLOWER_COOKED"
