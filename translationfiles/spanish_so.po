msgstr "Le hacen falta los ingredientes."

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.COONTAIL
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.COONTAIL"
