#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORKLAND_INTRO_FLAGS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORKLAND_INTRO_FLAGS"
