msgstr "Debería cocinar algo con ella."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.LOTUS_FLOWER_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.LOTUS_FLOWER_COOKED"
