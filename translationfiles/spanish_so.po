msgstr "Dentro se venden y compran artículos de Freyja."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_SHOP_GENERAL.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_SHOP_GENERAL.BURNING"
