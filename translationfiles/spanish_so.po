msgstr "Refleja la oscuridad de mi corazón."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECO_WALLORNAMENT_GEARS_ART
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECO_WALLORNAMENT_GEARS_ART"
