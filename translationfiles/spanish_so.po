msgstr "Un recuerdo de un guerrero caído."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHARK_GILLS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHARK_GILLS"
