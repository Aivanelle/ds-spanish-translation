msgstr "Bah. Se le ha aplicado energía térmica en exceso."

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.COOKPOT.COOKING_LONG"
