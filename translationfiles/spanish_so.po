msgstr "Así es mejor."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAWNORNAMENT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAWNORNAMENT.GENERIC"
