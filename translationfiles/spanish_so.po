msgstr "El exterior es aburrido."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WINDOW_SMALL_PEAKED_CURTAIN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WINDOW_SMALL_PEAKED_CURTAIN"
