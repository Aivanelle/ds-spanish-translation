#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SWINGING_LIGHT_FLORAL_BULB
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SWINGING_LIGHT_FLORAL_BULB"
