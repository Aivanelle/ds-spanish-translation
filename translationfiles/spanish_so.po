msgstr "Te ordeno que no te acerques."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_MONKEY.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_MONKEY.SLEEPING"
