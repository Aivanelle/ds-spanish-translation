msgstr "¡Qué rugosa!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.LIMPETROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.LIMPETROCK.GENERIC"
