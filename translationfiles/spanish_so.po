msgstr "Solo arena... por ahora..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHARK_FIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHARK_FIN"
