msgstr "Muy elefante, ¿eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SWINGING_LIGHT_DERBY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SWINGING_LIGHT_DERBY"
