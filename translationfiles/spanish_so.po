msgstr "Él también morirá pronto."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECO_WALLORNAMENT_WREATH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECO_WALLORNAMENT_WREATH"
