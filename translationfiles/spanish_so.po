msgstr "Solo añade agua."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.COFFEEBEANS_COOKED
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.COFFEEBEANS_COOKED"
