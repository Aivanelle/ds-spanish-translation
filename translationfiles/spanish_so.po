msgstr "¡Ñam, ñam, ñam!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.LOCKEDWES
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.LOCKEDWES"
