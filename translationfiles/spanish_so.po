msgstr "Tan acogedor."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SEA_CHIMINEA.OUT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SEA_CHIMINEA.OUT"
msgid "It finally went out."
msgstr "Finalmente se apagó."

