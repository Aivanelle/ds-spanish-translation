msgstr "Un paso más cerca de mi boca."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.LOBSTER_DEAD_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.LOBSTER_DEAD_COOKED"
