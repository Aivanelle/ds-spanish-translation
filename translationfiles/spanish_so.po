msgstr "¡Hola, señor Árbol!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.LIVING_ARTIFACT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.LIVING_ARTIFACT"
