msgstr "A quien quiero es a tu mamá..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHARKITTENSPAWNER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHARKITTENSPAWNER.GENERIC"
