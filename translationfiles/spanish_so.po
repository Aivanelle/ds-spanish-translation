msgstr "El sentimentalismo es absurdo."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECO_WALLORNAMENT_FULLLENGTH_MIRROR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECO_WALLORNAMENT_FULLLENGTH_MIRROR"
