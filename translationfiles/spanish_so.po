msgstr "Bien. Necesitamos una lámpara."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SWINGING_LIGHT_ROPE_2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SWINGING_LIGHT_ROPE_2"
