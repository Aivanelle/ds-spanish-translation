#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SWINGING_LIGHT_BASIC_METAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SWINGING_LIGHT_BASIC_METAL"
