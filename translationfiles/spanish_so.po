msgstr "Es muy rugoso."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_LIMESTONE_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_LIMESTONE_ITEM"
