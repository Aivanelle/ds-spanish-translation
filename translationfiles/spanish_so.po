msgstr "Ahora es el momento de escapar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_MONKEY_NEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_MONKEY_NEST"
