msgstr "Qué esssssstilo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_SWAMP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_SWAMP"
