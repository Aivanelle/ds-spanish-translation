msgstr "Eso es un montón de cuchilla."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAGIC_SEAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAGIC_SEAL"
