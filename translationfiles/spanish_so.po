msgstr "Tienen un aroma salado."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.LIMPETS_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.LIMPETS_COOKED"
